# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Where each var is used:
# - CLERK_SECRET_KEY                    -> server-side Clerk auth (middleware.ts, ClerkProvider in app/layout.tsx)
# - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY   -> client-side Clerk (ClerkProvider). Get both keys from https://dashboard.clerk.com -> API Keys
# - NEXT_PUBLIC_CLERK_SIGN_IN_URL       -> Clerk redirect, matches app/sign-in route
# - NEXT_PUBLIC_CLERK_SIGN_UP_URL       -> Clerk redirect, matches app/sign-up route
# - NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL -> post-login landing (HomeRedirect handles final routing to /onboarding or /shop/[id])
# - NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL -> post-signup landing (new users go through /onboarding)
# - NEXT_PUBLIC_API_URL                 -> app/utils/api/client.ts, must point at the NestJS backend (default http://localhost:5000)

CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

NEXT_PUBLIC_API_URL=http://localhost:5000

# --- AI Assistant (Groq / OpenAI Agent SDK) ---
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.groq.com/openai/v1

