# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Required envs and where they are used:
# - PORT                        -> src/main.ts (app.listen). Default 3000 in code, use 5000 to match frontend.
# - DATABASE_URL                -> src/db/db.service.ts, drizzle.config.ts, create-db.js, clear-db.js, test-db.js
# - CLERK_SECRET_KEY            -> src/auth/auth.guard.ts (Clerk token verification)
# - CLERK_WEBHOOK_SECRET        -> src/webhooks/webhooks.controller.ts (Svix webhook verification)
# - R2_BUCKET / R2_PUBLIC_URL / R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#                               -> src/upload/upload.service.ts (Cloudflare R2 / S3)

PORT=5000

# Public URL of the frontend (for CORS). Example: https://onbillo.vercel.app
FRONTEND_URL=https://onbillo.vercel.app

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onbillo

CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

R2_BUCKET=onbillo-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- AI Assistant (Groq / OpenAI Agent SDK) ---
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.groq.com/openai/v1


